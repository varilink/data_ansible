# This is the master, top-level configuration file for the DATA web application
# in the {{ subdomain }} environment.

# The fixed (environment independent) app configuration, both context specific
# (Config::Context) and general (Config::General).
include app/context.cfg
include app/general.cfg

# The location of the client side assets (stylesheets, javascripts, etc.).
assets /var/www/{{ server_name }}/html/
# The location of the web application's SQLite database.
database /var/www/{{ server_name }}/database/derbyartsandtheatre.db
# The location of the web applications Template::Toolkit templates.
tmpl_dir /var/www/{{ server_name }}/tt/

webmin 
all_emails_to_webmin yes
file_log_level {{ data_app_log_level | default('emergency') }}
use_captcha 0


