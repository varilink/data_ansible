{#
--------------------------------------------------------------------------------
app_web/templates/nginx_site_common.conf.j2
--------------------------------------------------------------------------------
#}
location = /_auth {
    internal;
    include uwsgi_params;
    uwsgi_pass unix:/run/uwsgi/{{ server_name }}.sock;
    uwsgi_param Host $host;
    uwsgi_pass_request_body off ;
    uwsgi_param QUERY_STRING "";
    uwsgi_param REQUEST_METHOD "GET";
    uwsgi_param CONTENT_LENGTH "";
    uwsgi_param HTTP_X_ORIGINAL_URI $request_uri;
}

location / {
    include uwsgi_params;
    uwsgi_modifier1 5;
    uwsgi_pass unix:/run/uwsgi/{{ server_name }}.sock;
    uwsgi_param Host $host;
    uwsgi_intercept_errors on;
    error_page 404 /not_found;
    error_page 500 /error;
}

location /secure {
    auth_request /_auth;
    include uwsgi_params;
    uwsgi_modifier1 5;
    uwsgi_pass unix:/run/uwsgi/{{ server_name }}.sock;
    uwsgi_param Host $host;
    uwsgi_intercept_errors on;
    error_page 404 /not_found;
    error_page 500 /error;
    error_page 401 /account/sign_in;
    error_page 403 /unauthorised;
}

location ~ ^/(assets|upload) {
    root /var/www/{{ server_name }}/html/;
}
